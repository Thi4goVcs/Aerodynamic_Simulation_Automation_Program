#include    "$FOAM_CASE/0/initialConditions"

     forces
     {
         type forces;
         libs ("libforces.so"); //Lib to load
         patches (walls); // change to your patch name
         rhoInf $rhoInf; //Reference density for fluid
         rho rhoInf;
         CofR (0.25 0 0); //Origin for moment calculations
         writeControl outputTime;
     }
     forceCoeffs
     {
         type forceCoeffs;
         libs ("libforces.so");
         patches (walls); //change to your patch name
         rhoInf $rhoInf;
         rho rhoInf; 
	 pName       p;
         UName       U;
         log         true; 
         CofR (0.25 0 0);
         liftDir (-$sen_alpha  $cos_alpha 0);
         dragDir ($cos_alpha $sen_alpha  0);
         pitchAxis (0 0 1);
         magUInf $U_mag;
         lRef 1.0;
         Aref 0.01;
         // one row every 10 iterations (was every 100): the run can now stop
         // early, and 20 samples gave the convergence check almost nothing to look at
         writeControl timeStep;
         writeInterval 10;
     }

     // Stops the run when Cd and Cl have stopped moving: each one's instantaneous
     // value stays within `tolerance` (ABSOLUTE) of its own moving average over
     // `window` (in TIME, so 0.2 = 200 iterations at deltaT 0.001). Both must hold
     // (same groupID; ungrouped conditions would stop on either one). Unlike
     // residualControl this does not depend on the mesh. endTime in controlDict is
     // only the safety ceiling. Checked every iteration, whatever writeInterval is.
     convergenciaCoeficientes
     {
         type            runTimeControl;
         libs            (utilityFunctionObjects);
         conditions
         {
             cdEstavel
             {
                 type            average;
                 functionObject  forceCoeffs;
                 fields          (Cd);
                 tolerance       1e-4;
                 window          0.2;
                 windowType      exact;
                 nIterStartUp    500;
                 groupID         1;
             }
             clEstavel
             {
                 type            average;
                 functionObject  forceCoeffs;
                 fields          (Cl);
                 tolerance       1e-3;
                 window          0.2;
                 windowType      exact;
                 nIterStartUp    500;
                 groupID         1;
             }
         }
         satisfiedAction end;
     }



fields (p); // 'p' é a pressão

    yplus
    {
       type                yPlus;
       functionObjectLibs  ("libutilityFunctionObjects.so");

       enabled true;

       writeControl outputTime;
    }


